{
  "name": "glasshour",
  "productName": "GlassHour",
  "version": "1.0.0",
  "description": "GlassHour · 琉璃沙漏 — 液态玻璃桌面倒计时组件 for Windows 10",
  "main": "electron/main.js",
  "author": "shibry88-netizen",
  "license": "MIT",
  "private": false,
  "scripts": {
    "start": "electron .",
    "shot": "node scripts/screenshot.js",
    "dist": "electron-builder --win --x64",
    "dist:dir": "electron-builder --win --x64 --dir"
  },
  "dependencies": {
    "koffi": "^2.9.0"
  },
  "devDependencies": {
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8",
    "playwright": "1.49.0"
  },
  "build": {
    "appId": "com.shibry88.glasshour",
    "productName": "GlassHour",
    "copyright": "Copyright © 2026 Shibry",
    "npmRebuild": false,
    "asar": true,
    "asarUnpack": [
      "**/node_modules/koffi/**"
    ],
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "electron/**/*",
      "renderer/**/*",
      "assets/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "artifactName": "${productName}-${version}-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "GlassHour",
      "artifactName": "${productName}-Setup-${version}.${ext}",
      "uninstallDisplayName": "GlassHour · 琉璃沙漏"
    },
    "portable": {
      "artifactName": "${productName}-Portable-${version}.${ext}"
    }
  }
}
